!Report TM59 for mechanically ventilated building

Schedule:Compact,
   TM59 Day Time Schedule,
   Fraction,
   Through: 12/31,
   For: AllDays,
   Until: 07:00, 0,
   Until: 22:00, 1,
   Until: 24:00, 0;
   
EnergyManagementSystem:Sensor,
   TM59_Day_Time_Schedule,
   TM59 Day Time Schedule,
   Schedule Value;
EnergyManagementSystem:Program,
   CIBSE_TM59_Reports ,

SET TMax_TM59 = 0.33 * Running_Average_Outdoor_Air_Temperature_TM59 + 21.8,

! Set up the zone TM59 OccSchedule which has value 1 when zone is occupied, it's TM59 summertime and the adaptive model temperature is in range

   If Adaptive_Model_Temperature_TM59 == -1,
      Set z00GROUNDFLOOR_LOUNGE_TM59_OccSchedule = 0,
   Elseif Month <= 4 || Month >= 10,
      Set z00GROUNDFLOOR_LOUNGE_TM59_OccSchedule = 0,
   Else,
      Set z00GROUNDFLOOR_LOUNGE_TM59_OccSchedule = z00GROUNDFLOOR_LOUNGE_OccSchedule_TM59,
   Endif,
   
   ! Consider air velocity in operative temperature calculation (using E+ Enegineering formula 19.199)
   IF z00GROUNDFLOOR_LOUNGE_Air_Velocity_TM59 < 0.2,
      SET gamma = 0.5,
   ELSEIF z00GROUNDFLOOR_LOUNGE_Air_Velocity_TM59 < 0.6,
      SET gamma = 0.4,
   ELSE,
      SET gamma = 0.3,
   ENDIF,

   SET z00GROUNDFLOOR_LOUNGE_Op_Temp_TM59 = gamma * z00GROUNDFLOOR_LOUNGE_Mean_Rad_Temp_TM59 + (1 - gamma) * z00GROUNDFLOOR_LOUNGE_Mean_Air_Temp_TM59,

   ! Calculate CIBSE_TM59 Delta T for this timestep
   SET Tmp = @Round(z00GROUNDFLOOR_LOUNGE_Op_Temp_TM59 - TMax_TM59),
   SET z00GROUNDFLOOR_LOUNGE_DeltaT = Tmp,
   ! ensure the Delta >= 0
   IF z00GROUNDFLOOR_LOUNGE_DeltaT < 0 ,
      SET z00GROUNDFLOOR_LOUNGE_DeltaT = 0,
   ENDIF,

   IF z00GROUNDFLOOR_LOUNGE_DeltaT > 0,
      ! uncomfortable
      SET z00GROUNDFLOOR_LOUNGE_CA = 100,
   ELSE,
      ! comfortable
      SET z00GROUNDFLOOR_LOUNGE_CA = 0,
   ENDIF,

  ! Calculate CIBSE TM_59 criteria for predominantly mechanically ventilated buildings
   IF z00GROUNDFLOOR_LOUNGE_Op_Temp_TM59 > 26,
      ! uncomfortable
       SET z00GROUNDFLOOR_LOUNGE_C_MECH_VENT = 100,
   ELSE,
      ! comfortable
      SET z00GROUNDFLOOR_LOUNGE_C_MECH_VENT = 0,
   ENDIF,

   If Adaptive_Model_Temperature_TM59 == -1,
      Set z00GROUNDFLOOR_KITCHEN_TM59_OccSchedule = 0,
   Elseif Month <= 4 || Month >= 10,
      Set z00GROUNDFLOOR_KITCHEN_TM59_OccSchedule = 0,
   Else,
      Set z00GROUNDFLOOR_KITCHEN_TM59_OccSchedule = z00GROUNDFLOOR_KITCHEN_OccSchedule_TM59,
   Endif,
   
   ! Consider air velocity in operative temperature calculation (using E+ Enegineering formula 19.199)
   IF z00GROUNDFLOOR_KITCHEN_Air_Velocity_TM59 < 0.2,
      SET gamma = 0.5,
   ELSEIF z00GROUNDFLOOR_KITCHEN_Air_Velocity_TM59 < 0.6,
      SET gamma = 0.4,
   ELSE,
      SET gamma = 0.3,
   ENDIF,

   SET z00GROUNDFLOOR_KITCHEN_Op_Temp_TM59 = gamma * z00GROUNDFLOOR_KITCHEN_Mean_Rad_Temp_TM59 + (1 - gamma) * z00GROUNDFLOOR_KITCHEN_Mean_Air_Temp_TM59,

   ! Calculate CIBSE_TM59 Delta T for this timestep
   SET Tmp = @Round(z00GROUNDFLOOR_KITCHEN_Op_Temp_TM59 - TMax_TM59),
   SET z00GROUNDFLOOR_KITCHEN_DeltaT = Tmp,
   ! ensure the Delta >= 0
   IF z00GROUNDFLOOR_KITCHEN_DeltaT < 0 ,
      SET z00GROUNDFLOOR_KITCHEN_DeltaT = 0,
   ENDIF,

   IF z00GROUNDFLOOR_KITCHEN_DeltaT > 0,
      ! uncomfortable
      SET z00GROUNDFLOOR_KITCHEN_CA = 100,
   ELSE,
      ! comfortable
      SET z00GROUNDFLOOR_KITCHEN_CA = 0,
   ENDIF,

  ! Calculate CIBSE TM_59 criteria for predominantly mechanically ventilated buildings
   IF z00GROUNDFLOOR_KITCHEN_Op_Temp_TM59 > 26,
      ! uncomfortable
       SET z00GROUNDFLOOR_KITCHEN_C_MECH_VENT = 100,
   ELSE,
      ! comfortable
      SET z00GROUNDFLOOR_KITCHEN_C_MECH_VENT = 0,
   ENDIF,

   If Adaptive_Model_Temperature_TM59 == -1,
      Set z01FIRSTFLOOR_BEDROOM2_TM59_OccSchedule = 0,
   Elseif Month <= 4 || Month >= 10,
      Set z01FIRSTFLOOR_BEDROOM2_TM59_OccSchedule = 0,
   Else,
      Set z01FIRSTFLOOR_BEDROOM2_TM59_OccSchedule = z01FIRSTFLOOR_BEDROOM2_OccSchedule_TM59,
   Endif,
   
   ! Consider air velocity in operative temperature calculation (using E+ Enegineering formula 19.199)
   IF z01FIRSTFLOOR_BEDROOM2_Air_Velocity_TM59 < 0.2,
      SET gamma = 0.5,
   ELSEIF z01FIRSTFLOOR_BEDROOM2_Air_Velocity_TM59 < 0.6,
      SET gamma = 0.4,
   ELSE,
      SET gamma = 0.3,
   ENDIF,

   SET z01FIRSTFLOOR_BEDROOM2_Op_Temp_TM59 = gamma * z01FIRSTFLOOR_BEDROOM2_Mean_Rad_Temp_TM59 + (1 - gamma) * z01FIRSTFLOOR_BEDROOM2_Mean_Air_Temp_TM59,

   ! Calculate CIBSE_TM59 Delta T for this timestep
   SET Tmp = @Round(z01FIRSTFLOOR_BEDROOM2_Op_Temp_TM59 - TMax_TM59),
   SET z01FIRSTFLOOR_BEDROOM2_DeltaT = Tmp,
   ! ensure the Delta >= 0
   IF z01FIRSTFLOOR_BEDROOM2_DeltaT < 0 ,
      SET z01FIRSTFLOOR_BEDROOM2_DeltaT = 0,
   ENDIF,

   IF z01FIRSTFLOOR_BEDROOM2_DeltaT > 0,
      ! uncomfortable
      SET z01FIRSTFLOOR_BEDROOM2_CA = 100,
   ELSE,
      ! comfortable
      SET z01FIRSTFLOOR_BEDROOM2_CA = 0,
   ENDIF,

  ! Calculate CIBSE TM_59 criteria for predominantly mechanically ventilated buildings
   IF z01FIRSTFLOOR_BEDROOM2_Op_Temp_TM59 > 26,
      ! uncomfortable
       SET z01FIRSTFLOOR_BEDROOM2_C_MECH_VENT = 100,
   ELSE,
      ! comfortable
      SET z01FIRSTFLOOR_BEDROOM2_C_MECH_VENT = 0,
   ENDIF,

   If Adaptive_Model_Temperature_TM59 == -1,
      Set z01FIRSTFLOOR_BEDROOM1_TM59_OccSchedule = 0,
   Elseif Month <= 4 || Month >= 10,
      Set z01FIRSTFLOOR_BEDROOM1_TM59_OccSchedule = 0,
   Else,
      Set z01FIRSTFLOOR_BEDROOM1_TM59_OccSchedule = z01FIRSTFLOOR_BEDROOM1_OccSchedule_TM59,
   Endif,
   
   ! Consider air velocity in operative temperature calculation (using E+ Enegineering formula 19.199)
   IF z01FIRSTFLOOR_BEDROOM1_Air_Velocity_TM59 < 0.2,
      SET gamma = 0.5,
   ELSEIF z01FIRSTFLOOR_BEDROOM1_Air_Velocity_TM59 < 0.6,
      SET gamma = 0.4,
   ELSE,
      SET gamma = 0.3,
   ENDIF,

   SET z01FIRSTFLOOR_BEDROOM1_Op_Temp_TM59 = gamma * z01FIRSTFLOOR_BEDROOM1_Mean_Rad_Temp_TM59 + (1 - gamma) * z01FIRSTFLOOR_BEDROOM1_Mean_Air_Temp_TM59,

   ! Calculate CIBSE_TM59 Delta T for this timestep
   SET Tmp = @Round(z01FIRSTFLOOR_BEDROOM1_Op_Temp_TM59 - TMax_TM59),
   SET z01FIRSTFLOOR_BEDROOM1_DeltaT = Tmp,
   ! ensure the Delta >= 0
   IF z01FIRSTFLOOR_BEDROOM1_DeltaT < 0 ,
      SET z01FIRSTFLOOR_BEDROOM1_DeltaT = 0,
   ENDIF,

   IF z01FIRSTFLOOR_BEDROOM1_DeltaT > 0,
      ! uncomfortable
      SET z01FIRSTFLOOR_BEDROOM1_CA = 100,
   ELSE,
      ! comfortable
      SET z01FIRSTFLOOR_BEDROOM1_CA = 0,
   ENDIF,

  ! Calculate CIBSE TM_59 criteria for predominantly mechanically ventilated buildings
   IF z01FIRSTFLOOR_BEDROOM1_Op_Temp_TM59 > 26,
      ! uncomfortable
       SET z01FIRSTFLOOR_BEDROOM1_C_MECH_VENT = 100,
   ELSE,
      ! comfortable
      SET z01FIRSTFLOOR_BEDROOM1_C_MECH_VENT = 0,
   ENDIF,

   If Adaptive_Model_Temperature_TM59 == -1,
      Set z02SECONDFLOOR_BEDROOM3_TM59_OccSchedule = 0,
   Elseif Month <= 4 || Month >= 10,
      Set z02SECONDFLOOR_BEDROOM3_TM59_OccSchedule = 0,
   Else,
      Set z02SECONDFLOOR_BEDROOM3_TM59_OccSchedule = z02SECONDFLOOR_BEDROOM3_OccSchedule_TM59,
   Endif,
   
   ! Consider air velocity in operative temperature calculation (using E+ Enegineering formula 19.199)
   IF z02SECONDFLOOR_BEDROOM3_Air_Velocity_TM59 < 0.2,
      SET gamma = 0.5,
   ELSEIF z02SECONDFLOOR_BEDROOM3_Air_Velocity_TM59 < 0.6,
      SET gamma = 0.4,
   ELSE,
      SET gamma = 0.3,
   ENDIF,

   SET z02SECONDFLOOR_BEDROOM3_Op_Temp_TM59 = gamma * z02SECONDFLOOR_BEDROOM3_Mean_Rad_Temp_TM59 + (1 - gamma) * z02SECONDFLOOR_BEDROOM3_Mean_Air_Temp_TM59,

   ! Calculate CIBSE_TM59 Delta T for this timestep
   SET Tmp = @Round(z02SECONDFLOOR_BEDROOM3_Op_Temp_TM59 - TMax_TM59),
   SET z02SECONDFLOOR_BEDROOM3_DeltaT = Tmp,
   ! ensure the Delta >= 0
   IF z02SECONDFLOOR_BEDROOM3_DeltaT < 0 ,
      SET z02SECONDFLOOR_BEDROOM3_DeltaT = 0,
   ENDIF,

   IF z02SECONDFLOOR_BEDROOM3_DeltaT > 0,
      ! uncomfortable
      SET z02SECONDFLOOR_BEDROOM3_CA = 100,
   ELSE,
      ! comfortable
      SET z02SECONDFLOOR_BEDROOM3_CA = 0,
   ENDIF,

  ! Calculate CIBSE TM_59 criteria for predominantly mechanically ventilated buildings
   IF z02SECONDFLOOR_BEDROOM3_Op_Temp_TM59 > 26,
      ! uncomfortable
       SET z02SECONDFLOOR_BEDROOM3_C_MECH_VENT = 100,
   ELSE,
      ! comfortable
      SET z02SECONDFLOOR_BEDROOM3_C_MECH_VENT = 0,
   ENDIF,

   If Adaptive_Model_Temperature_TM59 == -1,
      Set z02SECONDFLOOR_BEDROOM4_TM59_OccSchedule = 0,
   Elseif Month <= 4 || Month >= 10,
      Set z02SECONDFLOOR_BEDROOM4_TM59_OccSchedule = 0,
   Else,
      Set z02SECONDFLOOR_BEDROOM4_TM59_OccSchedule = z02SECONDFLOOR_BEDROOM4_OccSchedule_TM59,
   Endif,
   
   ! Consider air velocity in operative temperature calculation (using E+ Enegineering formula 19.199)
   IF z02SECONDFLOOR_BEDROOM4_Air_Velocity_TM59 < 0.2,
      SET gamma = 0.5,
   ELSEIF z02SECONDFLOOR_BEDROOM4_Air_Velocity_TM59 < 0.6,
      SET gamma = 0.4,
   ELSE,
      SET gamma = 0.3,
   ENDIF,

   SET z02SECONDFLOOR_BEDROOM4_Op_Temp_TM59 = gamma * z02SECONDFLOOR_BEDROOM4_Mean_Rad_Temp_TM59 + (1 - gamma) * z02SECONDFLOOR_BEDROOM4_Mean_Air_Temp_TM59,

   ! Calculate CIBSE_TM59 Delta T for this timestep
   SET Tmp = @Round(z02SECONDFLOOR_BEDROOM4_Op_Temp_TM59 - TMax_TM59),
   SET z02SECONDFLOOR_BEDROOM4_DeltaT = Tmp,
   ! ensure the Delta >= 0
   IF z02SECONDFLOOR_BEDROOM4_DeltaT < 0 ,
      SET z02SECONDFLOOR_BEDROOM4_DeltaT = 0,
   ENDIF,

   IF z02SECONDFLOOR_BEDROOM4_DeltaT > 0,
      ! uncomfortable
      SET z02SECONDFLOOR_BEDROOM4_CA = 100,
   ELSE,
      ! comfortable
      SET z02SECONDFLOOR_BEDROOM4_CA = 0,
   ENDIF,

  ! Calculate CIBSE TM_59 criteria for predominantly mechanically ventilated buildings
   IF z02SECONDFLOOR_BEDROOM4_Op_Temp_TM59 > 26,
      ! uncomfortable
       SET z02SECONDFLOOR_BEDROOM4_C_MECH_VENT = 100,
   ELSE,
      ! comfortable
      SET z02SECONDFLOOR_BEDROOM4_C_MECH_VENT = 0,
   ENDIF,

   ! Calculate CIBSE_TM59 criterion B which has value equal to timestep when zone is occupied and sleeping time

   If TM59_Day_Time_Schedule > 0,
      Set z01FIRSTFLOOR_BEDROOM2_CB = 0,
   Elseif z01FIRSTFLOOR_BEDROOM2_Op_Temp_TM59 > 26 && z01FIRSTFLOOR_BEDROOM2_Peple_Occ > 0,
      Set z01FIRSTFLOOR_BEDROOM2_CB = Zonetimestep,
   Else,
      Set z01FIRSTFLOOR_BEDROOM2_CB = 0,
   EndIf,

   If TM59_Day_Time_Schedule > 0,
      Set z01FIRSTFLOOR_BEDROOM1_CB = 0,
   Elseif z01FIRSTFLOOR_BEDROOM1_Op_Temp_TM59 > 26 && z01FIRSTFLOOR_BEDROOM1_Peple_Occ > 0,
      Set z01FIRSTFLOOR_BEDROOM1_CB = Zonetimestep,
   Else,
      Set z01FIRSTFLOOR_BEDROOM1_CB = 0,
   EndIf,

   If TM59_Day_Time_Schedule > 0,
      Set z02SECONDFLOOR_BEDROOM3_CB = 0,
   Elseif z02SECONDFLOOR_BEDROOM3_Op_Temp_TM59 > 26 && z02SECONDFLOOR_BEDROOM3_Peple_Occ > 0,
      Set z02SECONDFLOOR_BEDROOM3_CB = Zonetimestep,
   Else,
      Set z02SECONDFLOOR_BEDROOM3_CB = 0,
   EndIf,

   If TM59_Day_Time_Schedule > 0,
      Set z02SECONDFLOOR_BEDROOM4_CB = 0,
   Elseif z02SECONDFLOOR_BEDROOM4_Op_Temp_TM59 > 26 && z02SECONDFLOOR_BEDROOM4_Peple_Occ > 0,
      Set z02SECONDFLOOR_BEDROOM4_CB = Zonetimestep,
   Else,
      Set z02SECONDFLOOR_BEDROOM4_CB = 0,
   EndIf;


