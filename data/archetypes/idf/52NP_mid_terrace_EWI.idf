   Gypsum Plasterboard_.0125;                     !- .0125m

! Special material to represent an R-value for the next construction
Material:NoMass, 30_RVAL_4,                       !- Material name - Air gap 10mm
   Rough,                                         !- Roughness
   .15,                                           !- Resistance {m2-K/w}
   0.9,                                           !- Thermal Emittance
   0.7,                                           !- Solar Absorptance
   0.7;                                           !- Visible Absorptance

! <Previous reversed>
Construction, LSI Clay tiles occupied_Rev,
   Gypsum Plasterboard_.0125,                     !- .0125m
   Standard insulation_.102,                      !- .102m
   Roofing Felt_.005,                             !- .005m
   30_RVAL_4,                                     !- R-value
   Clay Tile (roofing)_.025;                      !- .025m

! LSI Loft space ceiling
Construction, LSI Loft space ceiling,
   Standard insulation_.1872,                     !- .1872m
   Gypsum Plasterboard_.0125;                     !- .0125m

! <Previous reversed>
Construction, LSI Loft space ceiling_Rev,
   Gypsum Plasterboard_.0125,                     !- .0125m
   Standard insulation_.1872;                     !- .1872m

! Link body
Construction, Link body,
   Link body_.1;                                  !- .1m

! <Previous reversed>
Construction, Link body_Rev,
   Link body_.1;                                  !- .1m



