    OpenWindows,
   
IF z00GROUNDFLOOR_LOUNGE_Wall_6_0_0_1_0_2_Win_Can_Open,
   IF z00GROUNDFLOOR_LOUNGE_Wall_6_0_0_1_0_2_Win_Zone_Mean_Air_Temperature > 22,
      IF  z00GROUNDFLOOR_LOUNGE_Wall_6_0_0_1_0_2_Win_Zone_Mean_Air_Temperature < Out_DryAir_Temp,
         SET Venting_Opening_Factor_z00GROUNDFLOOR_LOUNGE_Wall_6_0_0_1_0_2_Win = 1,
      ELSE,      
         SET Venting_Opening_Factor_z00GROUNDFLOOR_LOUNGE_Wall_6_0_0_1_0_2_Win = null,
      ENDIF,
   ELSE,
     SET Venting_Opening_Factor_z00GROUNDFLOOR_LOUNGE_Wall_6_0_0_1_0_2_Win = null,
   ENDIF,
