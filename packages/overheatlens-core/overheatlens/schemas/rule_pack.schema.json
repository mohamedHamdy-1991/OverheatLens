{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overheatlens.org/schemas/rule_pack.schema.json",
  "title": "OverheatLens rule pack",
  "description": "A versioned, source-traceable assessment-method rule pack. Every threshold carries a source reference and verification status; unverified packs are evaluation-gated in code.",
  "type": "object",
  "required": ["rule_pack", "version", "title", "publisher", "source_status", "source_refs"],
  "$defs": {
    "adaptiveCategory": {
      "type": "object",
      "required": ["linear_slope_k_per_c", "clamp_min_c", "clamp_max_c"],
      "additionalProperties": false,
      "properties": {
        "linear_slope_k_per_c": {"type": "number"},
        "clamp_min_c": {"type": "number"},
        "clamp_max_c": {"type": "number"},
        "clamp_trm_min_c": {"type": "number"},
        "clamp_trm_max_c": {"type": "number"},
        "offset_c": {"type": "number"}
      }
    }
  },
  "additionalProperties": false,
  "properties": {
    "rule_pack": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+.*$"},
    "title": {"type": "string", "minLength": 1},
    "publisher": {"type": "string", "minLength": 1},
    "edition": {"type": "string"},
    "inherits": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "source_status": {
      "enum": ["source_verified", "secondary_pending", "blocked_no_source"]
    },
    "source_refs": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "pattern": "^[SWD]-[0-9]{2}$"}
    },
    "verification_note": {"type": "string"},
    "weather_requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {"type": "string"},
        "recommended_minimum": {"type": "string"},
        "note": {"type": "string"},
        "verified": {"type": "boolean"},
        "fallback_limitation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "designated_fallback": {"type": "string"},
            "applicable": {"type": "boolean"},
            "note": {"type": "string"}
          }
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "period": {"type": "string"},
        "hour_basis": {"type": "integer"},
        "window": {"type": "string"},
        "months": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"type": "integer", "minimum": 1, "maximum": 12}
        },
        "dwelling_category_default": {"enum": ["I", "II"]},
        "note": {"type": "string"}
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "criteria"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "description": {"type": "string"},
          "criteria": {"type": "array", "items": {"type": "string"}},
          "mode_selection_rule": {"type": "string"},
          "verification": {
            "type": "object",
            "required": ["source", "status"],
            "additionalProperties": false,
            "properties": {
              "source": {"type": "string", "pattern": "^[SWD]-[0-9]{2}$"},
              "status": {"enum": ["source_verified", "secondary_pending", "blocked_no_source"]}
            }
          }
        }
      }
    },
    "space_types": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["criteria"],
        "additionalProperties": false,
        "properties": {
          "aliases": {"type": "array", "items": {"type": "string"}},
          "criteria": {"type": "array", "items": {"type": "string"}},
          "note": {"type": "string"}
        }
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "applies_to", "metric", "threshold", "units", "operator",
                     "window", "aggregation", "verification"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "applies_to": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "clause": {"type": "string"},
          "metric": {"type": "string", "minLength": 1},
          "condition": {"type": "string"},
          "window": {"type": "string", "minLength": 1},
          "aggregation": {"type": "string", "minLength": 1},
          "threshold": {"type": "number"},
          "units": {"type": "string", "minLength": 1},
          "operator": {"type": "string", "enum": [">", ">=", "<", "<=", "=="]},
          "rounding": {"type": "string"},
          "months": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "items": {"type": "integer", "minimum": 1, "maximum": 12}
          },
          "occupancy_basis": {
            "enum": ["living_hours", "all_hours", "model_supplied", "custom"]
          },
          "occupancy_hours_basis": {"type": "integer", "minimum": 1},
          "max_exceedance_hours": {"type": "number"},
          "max_nights": {"type": "number"},
          "sleep_window": {"type": "string"},
          "category_thresholds": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "I": {"type": "number"},
              "II": {"type": "number"}
            }
          },
          "adaptive_threshold": {
            "type": "object",
            "required": ["category_I", "category_II"],
            "additionalProperties": false,
            "properties": {
              "category_I": {"$ref": "#/$defs/adaptiveCategory"},
              "category_II": {"$ref": "#/$defs/adaptiveCategory"}
            }
          },
          "ceiling_fan_uplift": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_uplift_c": {"type": "number"},
              "air_speed_threshold_ms": {"type": "number"},
              "temperature_condition_c": {"type": "number"},
              "per_0_1ms_below_c": {"type": "number"},
              "source_note": {"type": "string"}
            }
          },
          "delta_t_rounding": {"type": "string"},
          "adaptive_threshold_ref": {"type": "string"},
          "variants": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "occupancy_basis": {"enum": ["living_hours", "all_hours", "model_supplied", "custom"]},
                "occupancy_hours_basis": {"type": "integer", "minimum": 1},
                "max_exceedance_hours": {"type": "number"},
                "note": {"type": "string"}
              }
            }
          },
          "stage_applicability": {"type": "array", "items": {"type": "string"}},
          "advisory": {"type": "boolean"},
          "ventilation_route": {"enum": ["natural", "mechanical"]},
          "interpretation_note": {"type": "string"},
          "method_ref": {"type": "string"},
          "not_implemented": {"type": "boolean"},
          "verification": {
            "type": "object",
            "required": ["source", "status"],
            "additionalProperties": false,
            "properties": {
              "source": {"type": "string", "pattern": "^[SWD]-[0-9]{2}$"},
              "status": {"enum": ["source_verified", "secondary_pending", "blocked_no_source"]}
            }
          }
        }
      }
    },
    "model_limits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "clause", "requirement", "verification"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "clause": {"type": "string"},
          "requirement": {"type": "string"},
          "parameters": {"type": "object"},
          "verification": {
            "type": "object",
            "required": ["source", "status"],
            "additionalProperties": false,
            "properties": {
              "source": {"type": "string", "pattern": "^[SWD]-[0-9]{2}$"},
              "status": {"enum": ["source_verified", "secondary_pending", "blocked_no_source"]}
            }
          }
        }
      }
    },
    "strategy_exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "clause", "requirement", "verification"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "clause": {"type": "string"},
          "requirement": {"type": "string"},
          "verification": {
            "type": "object",
            "required": ["source", "status"],
            "additionalProperties": false,
            "properties": {
              "source": {"type": "string", "pattern": "^[SWD]-[0-9]{2}$"},
              "status": {"enum": ["source_verified", "secondary_pending", "blocked_no_source"]}
            }
          }
        }
      }
    },
    "report_requirements": {"type": "array", "items": {"type": "string"}},
    "weather_note": {"type": "string"},
    "blocked": {"type": "string"},
    "changelog": {"type": "array", "items": {"type": "string"}}
  }
}
