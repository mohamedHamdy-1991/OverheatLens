!-Fixture: Leeds archetype template — new-build semi-detached house, 2020s (overheatlens project).
!-Derived from fixtures/idf/synthetic_dwelling.idf (field layouts verified against the
!-EnergyPlus 25.1 IDD). Illustrative template: representative form and fabric of a 2020s
!-semi-detached new build — highly insulated cavity walls, large glazing, 0.25 ach
!-infiltration — NOT a surveyed dwelling. Same RunPeriod, gains patterns and outputs as
!-the synthetic fixture.

Version, 25.1;

Timestep, 6;

SimulationControl,
  No, No, No, No, Yes;

RunPeriod,
  Annual run,              !- Name (A1 is a NAME field in IDD 25.1)
  1, 1,                    !- Begin Month / Day
  ,                        !- Begin Year
  12, 31,                  !- End Month / Day
  ,                        !- End Year
  Monday,                  !- Day of Week for Start Day
  Yes, Yes, Yes, Yes;

Building,
  Leeds Semi New Build,
  0, Suburbs,
  0.04, 0.4,
  FullExterior,
  30, 6;

GlobalGeometryRules,
  UpperLeftCorner, CounterClockwise, World, World, World;

!- ------------------ constructions (2020s insulated cavity) --------------------

Material,
  G01a 19mm gypsum board,
  MediumSmooth,
  0.019,
  0.16,
  800,
  1090,
  0.9, 0.4, 0.0;

Material,
  B02 102mm brick outer leaf,
  MediumRough,
  0.102,
  0.77,
  1700,
  840,
  0.9, 0.7, 0.7;

Material,
  IW18 180mm mineral wool,
  Rough,
  0.180,
  0.030,
  43,
  840,
  0.9, 0.5, 0.5;

Material,
  M11 100mm lightweight roof,
  Rough,
  0.1,
  0.14,
  300,
  1400,
  0.9, 0.6, 0.0;

Material:AirGap,
  F04 Wall air gap resistance, 0.15;
Material:AirGap,
  F05 Floor air gap resistance, 0.17;
Material:AirGap,
  F04 Ceiling air gap resistance, 0.17;

Construction,
  Cavity Wall 2020s,
  B02 102mm brick outer leaf,
  F04 Wall air gap resistance,
  IW18 180mm mineral wool,
  G01a 19mm gypsum board;

Construction,
  Light Roof,
  M11 100mm lightweight roof,
  F04 Ceiling air gap resistance,
  G01a 19mm gypsum board;

Construction,
  Light Floor,
  G01a 19mm gypsum board,
  F05 Floor air gap resistance,
  G01a 19mm gypsum board;

WindowMaterial:SimpleGlazingSystem,
  Simple glazing,
  1.4,
  0.6,
  0.7;

Construction,
  Window construction,
  Simple glazing;

!- -------------------------------- zones ---------------------------------------
!- Living room 6.0 x 4.5 m; Bedroom 1 5.0 x 4.0 m; height 2.7 m.

Zone,
  Living room,             !- Name (A1)
  0,                       !- Direction of Relative North (N1)
  0, 0, 0,                 !- XYZ Origin (N2-N4)
  1,                       !- Type (N5)
  1,                       !- Multiplier (N6)
  autocalculate,           !- Ceiling Height (N7)
  autocalculate,           !- Volume (N8)
  autocalculate,           !- Floor Area (N9)
  ,                        !- Inside Convection Algorithm (A2)
  ,                        !- Outside Convection Algorithm (A3)
  yes;                     !- Part of Total Floor Area (A4)

Zone,
  Bedroom 1,
  0,
  0, 0, 0,
  1,
  1,
  autocalculate,
  autocalculate,
  autocalculate,
  ,
  ,
  yes;

