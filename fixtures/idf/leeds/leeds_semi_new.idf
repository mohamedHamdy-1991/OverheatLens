  Living window,
  Window,
  Window construction,
  Living room Wall N,
  ,
  autocalculate,
  ,
  1.0,
  4,
  1.5, 0, 2.4,  4.5, 0, 2.4,  4.5, 0, 0.9,  1.5, 0, 0.9;

