!- Windows: A1 Name, A2 Type, A3 Construction, A4 Base Surface, A5 OBC Object,
!- N1 View Factor, A6 Frame/Divider, N2 Multiplier, N3 Number of Vertices, coords.
!- Small 1950s openings: living 1.0 x 1.6 m, bedroom 1.0 x 1.2 m.

FenestrationSurface:Detailed,
  Living window,
  Window,
  Window construction,
  Living room Wall N,
  ,
  autocalculate,
  ,
  1.0,
  4,
  2, 0, 2.4,  3, 0, 2.4,  3, 0, 0.8,  2, 0, 0.8;

FenestrationSurface:Detailed,
  Bedroom window,
  Window,
  Window construction,
  Bedroom Wall N,
  ,
  autocalculate,
  ,
  1.0,
  4,
  1.5, 0, 2.2,  2.5, 0, 2.2,  2.5, 0, 1.0,  1.5, 0, 1.0;

!- --------------------- schedules (TM59-style profiles) ------------------------

ScheduleTypeLimits,
  Fraction,
  0.0, 1.0, CONTINUOUS;

ScheduleTypeLimits,
  AnyNumber;

Schedule:Compact,
  Living occupancy,
  Fraction,
  Through: 12/31,
  For: AllDays,
  Until: 09:00, 0.0,
  Until: 22:00, 1.0,
  Until: 24:00, 0.0;

Schedule:Compact,
  Bedroom occupancy,
  Fraction,
  Through: 12/31,
  For: AllDays,
  Until: 08:00, 1.0,
  Until: 23:00, 0.0,
  Until: 24:00, 1.0;

Schedule:Compact,
  Living equipment,
  Fraction,
  Through: 12/31,
  For: AllDays,
  Until: 09:00, 0.1,
  Until: 22:00, 1.0,
  Until: 24:00, 0.2;

Schedule:Compact,
  Bedroom equipment,
  Fraction,
  Through: 12/31,
  For: AllDays,
  Until: 08:00, 0.3,
  Until: 23:00, 0.05,
  Until: 24:00, 0.3;

Schedule:Compact,
  Vent availability,
  Fraction,
  Through: 12/31,
  For: AllDays,
  Until: 24:00, 1.0;

Schedule:Compact,
  Activity level,
  AnyNumber,
  Through: 12/31,
  For: AllDays,
  Until: 24:00, 120;

