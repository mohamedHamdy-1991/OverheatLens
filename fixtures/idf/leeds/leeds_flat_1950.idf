  Bedroom 1,
  ,
  Outdoors,
  ,
  SunExposed,
  WindExposed,
  autocalculate,
  4,
  0, 0, 2.7,  4, 0, 2.7,  4, 0, 0,  0, 0, 0;

BuildingSurface:Detailed,
  Bedroom Floor,
  Floor,
  Light Floor,
  Bedroom 1,
  ,
  Ground,
  ,
  NoSun,
  NoWind,
  autocalculate,
  4,
  0, 0, 0,  4, 0, 0,  4, -3.5, 0,  0, -3.5, 0;

BuildingSurface:Detailed,
  Bedroom Roof,
  Roof,
  Light Roof,
  Bedroom 1,
  ,
  Outdoors,
  ,
  SunExposed,
