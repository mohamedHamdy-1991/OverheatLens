!- People: A1 Name, A2 Zone, A3 Schedule, A4 Method, N1 Count, N2 per-area,
!- N3 area-per-person, N4 Fraction Radiant, N5 Sensible Heat Fraction, A5 Activity.

People,
  Living room People,
  Living room,
  Living occupancy,
  People,
  2,
  0,
  0,
  0.3,
  0.3,
  Activity level;

People,
  Bedroom People,
  Bedroom 1,
  Bedroom occupancy,
  People,
  2,
  0,
  0,
  0.3,
  0.3,
  Activity level;

Lights,
  Living room Lights,
  Living room,
  Living equipment,
  LightingLevel,
  100,
  0,
  0,
  0.3,
  0.4;

Lights,
  Bedroom Lights,
  Bedroom 1,
  Bedroom equipment,
  LightingLevel,
  60,
  0,
  0,
  0.3,
  0.4;

ElectricEquipment,
