!- --------------------------- infiltration + openings ---------------------------
!- Leaky 1950s fabric: 0.5 ach design infiltration.

ZoneInfiltration:DesignFlowRate,
  Living room Infiltration,
  Living room,
  Vent availability,
  AirChanges/Hour,
  ,                      !- Design Flow Rate (N1)
  ,                      !- Flow Rate per Floor Area (N2)
  ,                      !- Flow Rate per Exterior Surface Area (N3)
  0.5;                   !- Air Changes per Hour (N4)

ZoneInfiltration:DesignFlowRate,
  Bedroom Infiltration,
  Bedroom 1,
  Vent availability,
  AirChanges/Hour,
  ,                      !- Design Flow Rate (N1)
  ,                      !- Flow Rate per Floor Area (N2)
  ,                      !- Flow Rate per Exterior Surface Area (N3)
  0.5;                   !- Air Changes per Hour (N4)

!- ZoneVentilation:WindandStackOpenArea (IDD 25.1): A1 Name, A2 Zone,
!- N1 Opening Area, A3 Schedule, N2 Effectiveness, N3 Angle, N4 Height Diff,
!- N5 Discharge Coefficient.

ZoneVentilation:WindandStackOpenArea,
  Living window Vent,
  Living room,
  1.0,
  Vent availability,
  0.5,
  0.0,
  1.1,
  0.45;

ZoneVentilation:WindandStackOpenArea,
  Bedroom window Vent,
  Bedroom 1,
  0.75,
  Vent availability,
  0.5,
  0.0,
  1.1,
  0.45;

!- -------------------------------- outputs --------------------------------------

Output:Variable,
  *,
  Zone Mean Air Temperature,
  hourly;

Output:Variable,
  *,
  Zone Mean Radiant Temperature,
  hourly;

Output:Variable,
  *,
  Zone Air Relative Humidity,
  hourly;
