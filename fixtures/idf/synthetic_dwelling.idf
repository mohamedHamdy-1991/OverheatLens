FenestrationSurface:Detailed,
  Living window,           !- Name
  Window,                  !- Surface Type
  3.0,                     !- Area (m2) — ~1/20 floor area for Part F purge readiness
  Living room Wall N,      !- Base Surface
  0,                       !- Frame divider
  0.5,                     !- U-value
  0.6,                     !- SHGC
  0.7,                     !- Visible transmittance
  2,                       !- Number of vertices
  2, 0, 2.2,  6, 0, 2.2;

