!-Fixture: Synthetic two-zone dwelling for OverheatLens tests (overheatlens project).
!-Field layouts verified against the EnergyPlus 25.1 IDD (Energy+.idd). Deliberately
!-simple: two lightweight ground-level zones, TM59-style occupancy/gains, operable
!-openings (ZoneVentilation:WindandStackOpenArea), TM59 infiltration, hourly Zone
!-Mean Air / Mean Radiant Temperature outputs. Physics is illustrative; the fixture
!-exists to exercise readiness checks, the EnergyPlus runner and the harvest ->
!-standards-evaluation chain end to end.

Version, 25.1;

Timestep, 6;

SimulationControl,
  No, No, No, No, Yes;

RunPeriod,
  Annual run,              !- Name (A1 is a NAME field in IDD 25.1)
  1, 1,                    !- Begin Month / Day
  ,                        !- Begin Year
  12, 31,                  !- End Month / Day
  ,                        !- End Year
  Monday,                  !- Day of Week for Start Day
  Yes, Yes, Yes, Yes;

Building,
  Synthetic Dwelling,
  0, Suburbs,
  0.04, 0.4,
  FullExterior,
  30, 6;

GlobalGeometryRules,
  UpperLeftCorner, CounterClockwise, World, World, World;

!- ------------------ constructions (illustrative lightweight) ------------------

Material,
  G01a 19mm gypsum board,
  MediumSmooth,
  0.019,
  0.16,
  800,
  1090,
  0.9, 0.4, 0.0;

Material,
  M11 100mm lightweight roof,
  Rough,
  0.1,
  0.14,
  300,
  1400,
  0.9, 0.6, 0.0;

Material:AirGap,
  F04 Wall air gap resistance, 0.15;
Material:AirGap,
  F05 Floor air gap resistance, 0.17;
Material:AirGap,
  F04 Ceiling air gap resistance, 0.17;

Construction,
  Light Wall,
  G01a 19mm gypsum board,
  F04 Wall air gap resistance,
  G01a 19mm gypsum board;

Construction,
  Light Roof,
  M11 100mm lightweight roof,
  F04 Ceiling air gap resistance,
  G01a 19mm gypsum board;

Construction,
  Light Floor,
  G01a 19mm gypsum board,
  F05 Floor air gap resistance,
  G01a 19mm gypsum board;

WindowMaterial:SimpleGlazingSystem,
  Simple glazing,
  1.4,
  0.6,
  0.7;

Construction,
  Window construction,
  Simple glazing;

!- -------------------------------- zones ---------------------------------------

Zone,
  Living room,             !- Name (A1)
  0,                       !- Direction of Relative North (N1)
  0, 0, 0,                 !- XYZ Origin (N2-N4)
  1,                       !- Type (N5)
  1,                       !- Multiplier (N6)
  autocalculate,           !- Ceiling Height (N7)
  autocalculate,           !- Volume (N8)
  autocalculate,           !- Floor Area (N9)
  ,                        !- Inside Convection Algorithm (A2)
  ,                        !- Outside Convection Algorithm (A3)
  yes;                     !- Part of Total Floor Area (A4)

Zone,
  Bedroom 1,
  0,
  0, 0, 0,
  1,
  1,
  autocalculate,
  autocalculate,
  autocalculate,
  ,
  ,
  yes;

