!-Fixture: Synthetic two-zone dwelling for OverheatLens tests (overheatlens project).
!-Deliberately simple: two lightweight zones, TM59-style occupancy, operable window
!-openings (ZoneVentilation:WindAndStackOpenArea), TM59 internal gains, hourly
!-Zone Mean Air / Mean Radiant Temperature outputs. Physics is illustrative; the
!-fixture exists to exercise the readiness checks, the EnergyPlus runner and the
!-harvest/evaluation chain end to end.

Version, 25.1;

Timestep, 6;

SimulationControl,
  No,                      !- Do Zone Sizing Calculation
  No,                      !- Do System Sizing Calculation
  No,                      !- Do Plant Sizing Calculation
  No,                      !- Run Simulation for Sizing Periods
  Yes;                     !- Run Simulation for Weather File Run Periods

RunPeriod,
  1,                       !- Begin Month
  1,                       !- Begin Day of Month
  12,                      !- End Month
  31,                      !- End Day of Month
  Monday,                  !- Day of Week for Start Day
  Yes,                     !- Use Weather File Holidays and Special Days
  Yes,                     !- Use Weather File Daylight Saving Period
  Yes,                     !- Apply Weekend Holiday Rule
  Yes;                     !- Use Weather File Rain Indicators

Building,
  Synthetic Dwelling,      !- Name
  0,                       !- North Axis
  Suburbs,                 !- Terrain
  0.04,                    !- Loads Convergence Tolerance Value
  0.4,                     !- Temperature Convergence Tolerance Value
  FullExterior,            !- Solar Distribution
  30,                      !- Maximum Number of Warmup Days
  6;                       !- Minimum Number of Warmup Days

Zone,
  Living room,             !- Name
  0,                       !- Direction of Relative North
  0, 0, 0,                 !- XYZ Origin
  1,                       !- Type
  1,                       !- Multiplier
  autocalculate, autocalculate, autocalculate,
  autocalculate,           !- Ceiling/Wall/Floor Height
  yes;                     !- Part of Total Floor Area

Zone,
  Bedroom 1,               !- Name
  0,
  0, 0, 3,
  1,
  1,
  autocalculate, autocalculate, autocalculate,
  autocalculate,
  yes;

GlobalGeometryRules,
  UpperLeftCorner, CounterClockwise, WorldCoordinateSystem;

!- Lightweight constructions (illustrative values)
Construction,
  Light Wall,
  G01a 19mm gypsum board,
  F04 Wall air gap resistance,
  G01a 19mm gypsum board;

Construction,
  Light Roof,
  M11 100mm lightweight roof,
  F04 Ceiling air gap resistance,
  G01a 19mm gypsum board;

Construction,
  Light Floor,
  G01a 19mm gypsum board,
  F05 Floor air gap resistance,
  G01a 19mm gypsum board;

Material:AirGap,
  F04 Wall air gap resistance, 0.15;
Material:AirGap,
  F05 Floor air gap resistance, 0.17;
Material:AirGap,
  F04 Ceiling air gap resistance, 0.17;

Material,
  G01a 19mm gypsum board,  !- Name
  MediumSmooth,            !- Roughness
  0.019,                   !- Thickness
  0.16,                    !- Conductivity
  800,                     !- Density
  1090,                    !- Specific Heat
  0.9, 0.4, 0.0, 0.0;      !- Thermal absorptance etc.

Material,
  M11 100mm lightweight roof,
  Rough,
  0.1,
  0.14,
  300,
  1400,
  0.9, 0.6, 0.0, 0.0;

BuildingSurface:Detailed,
  Living room Wall N,      !- Name
  Wall,                    !- Surface Type
  Light Wall,              !- Construction Name
  Living room,             !- Zone Name
  Outdoors,                !- Outside Boundary Condition
  ,                        !- Outside Boundary Condition Object
  SunExposed, WindExposed,
  4,                       !- Number of Vertices
  0, 0, 2.7,  8, 0, 2.7,  8, 0, 0,  0, 0, 0;

